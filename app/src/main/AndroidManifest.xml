<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Smart Pantry Manager"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager"
        tools:targetApi="31">

        <!-- Main Pantry List Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="My Pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Suggested Recipes Screen -->
        <activity
            android:name=".RecipeActivity"
            android:exported="false"
            android:label="Suggested Recipes" />

        <!-- Recipe Detail Screen - REQUIRED -->
        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:label="Recipe Details" />

        <!-- Settings Screen - REQUIRED for 4 screens -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

    </application>

</manifest>